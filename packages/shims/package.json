{
  "name": "@localpay/shim-node",
  "version": "0.0.0",
  "description": "Point the official Razorpay Node SDK at a local LocalPay server. Independent project, not affiliated with Razorpay.",
  "private": false,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "peerDependencies": {
    "razorpay": "^2.9.0"
  },
  "devDependencies": {
    "@localpay/server": "workspace:*",
    "razorpay": "^2.9.8"
  },
  "license": "Apache-2.0",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karthikrshet/localpay.git",
    "directory": "packages/shims"
  },
  "keywords": [
    "localpay",
    "razorpay-node",
    "sdk",
    "razorpay-compatible",
    "razorpay",
    "razorpay-api",
    "razorpay-test",
    "payment-gateway",
    "payments",
    "mock-server",
    "api-mock",
    "emulator",
    "webhooks",
    "webhook-testing",
    "upi",
    "india",
    "testing",
    "integration-testing",
    "local-development",
    "offline",
    "developer-tools",
    "ci"
  ],
  "homepage": "https://karthikrshet.github.io/localpay/",
  "bugs": {
    "url": "https://github.com/karthikrshet/localpay/issues"
  }
}
