{
  "name": "localpay-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/checkout/tsconfig.json && tsc -p packages/dashboard/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "spike": "node --experimental-strip-types scripts/spike/create-order.ts",
    "check-secrets": "node --experimental-strip-types --no-warnings scripts/check-secrets.ts",
    "scrub-fixtures": "node --experimental-strip-types --no-warnings scripts/scrub-fixtures.ts",
    "record-fixtures": "node --experimental-strip-types --no-warnings scripts/record-fixtures.ts",
    "test:compat": "vitest run fixtures",
    "test:e2e": "playwright test",
    "localpay": "node --experimental-strip-types --no-warnings packages/cli/src/bin.ts",
    "build": "pnpm --filter @localpay/checkout build && pnpm --filter @localpay/dashboard build && pnpm --filter localpay build && pnpm --filter @localpay/shim-node build",
    "smoke:package": "node --experimental-strip-types --no-warnings scripts/smoke-package.ts",
    "changeset": "changeset",
    "test:coverage": "vitest run packages/core packages/provider-razorpay --coverage"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@localpay/server": "workspace:*",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
